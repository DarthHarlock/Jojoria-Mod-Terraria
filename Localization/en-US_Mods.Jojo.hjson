	ScaryMonstersItem_Tier_4: {
		DisplayName: Scary Monsters Tier 4
		Tooltip:
			'''
			[c/00A5FF:Passive]) [c/00A5FF:Dino Virus]: Scratches inflict the Dino Virus infection. After [c/00A5FF:7] seconds, the enemy will turn into a dinosaur that will serve you and spread the infection
			Transformed dinosaurs have [c/00A5FF:20] Stand-class damage and their health is calculated by adding:
			[c/00A5FF:210] + the transformed enemy's health.
			​​
			[c/00A5FF:Passive]) [c/00A5FF:Scales]: Your transformed body allows you to have [c/00A5FF:10%] more damage and [c/00A5FF:25%] more speed
			​​
			[c/00A5FF:1]) [c/00A5FF:Dino-Crisis]: Summons [c/00A5FF:4] dinosaurs that will protect you, dealing [c/00A5FF:35] Stand-class damage
			​​
			[c/00A5FF:2]) [c/00A5FF:Awakening]: You will fully transform and gain more attack range. Also, if you use the «Dino-Crisis» ability, you will summon [c/00A5FF:5] dinosaurs
			'''
	}

