	CrazyDiamondItem_Tier_4: {
		DisplayName: Crazy Diamond Tier 4
		Tooltip:
			'''
			[c/77CCF1:1]) [c/77CCF1:Transformationsmodus]: Wenn du einen Gegner lange genug triffst, verschmilzt du ihn mit einem Stein und er erleidet [c/77CCF1:x6] Schaden
			​​
			[c/77CCF1:Passiv]) [c/77CCF1:Wiederherstellung]: Ermöglicht es dir, andere Spieler und Kreaturen zu heilen.
			​​
			[c/77CCF1:Passiv]) [c/77CCF1:Zerlegen]: Wenn du ein Objekt auf dem Boden triffst, verwandelt es sich in seine ursprünglichen Herstellungsmaterialien zurück
			​​
			[c/77CCF1:2]) [c/77CCF1:Steinschild]: Bildet einen Schild aus [c/77CCF1:20] Steinen, der den Benutzer vor Projektilen und physischen Angriffen schützt
			'''
	}

