	SilverChariotRequiemItem_Requiem: {
		Tooltip:
			'''
			([c/5913D5:Passive Fähigkeit]) [c/5913D5:Dunkle Atmosphäre]: Wendet alle 20 Sekunden die Debuffs von Chariot Requiem auf alle Kreaturen in der Nähe an.
			​​
			[c/5913D5:1]) [c/5913D5:Requiems Wille]: Lässt alle Wesen in einem Bereich in einen tiefen Schlaf fallen. Sie können durch erlittenen Schaden aufwachen.
			​​
			[c/5913D5:2]) [c/5913D5:Seelenmutation]: Wendet in einem beträchtlichen Bereich dauerhafte Debuffs an, darunter:
			Verlangsamung des Gegners um 50%, Senkung der Verteidigung um 50%, Mutierte Blutung.
			​​
			[c/5913D5:3]) [c/5913D5:Dunkle Spiegelung]: Jeder Angriff auf Chariot Requiem wird automatisch auf den Angreifer zurückgeworfen.
			'''
		DisplayName: Silver Chariot Requiem Tier Requiem
	}

