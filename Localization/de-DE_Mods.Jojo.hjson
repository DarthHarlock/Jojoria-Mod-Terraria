Items: {
	WhiteSnakeItem_Tier_4: {
		Tooltip:
			'''
			([c/2B4EAD:Rechtsklick]) [c/2B4EAD:Gedächtnisraub]: Platziert den Stand auf dem Gegner, der nach kurzer Zeit die Fähigkeit zu Bewegung und Angriff verliert
			Normale Gegner werden für [c/2B4EAD:20] Sekunden außer Gefecht gesetzt, Bosse für [c/2B4EAD:6] Sekunden
			​​
			([c/2B4EAD:1]) [c/2B4EAD:Verdauungsnebel]: Erzeugt eine Flüssigkeit, die an Oberflächen haftet und dauerhaften Schaden sowie eine Verlangsamung verursacht.
			(Die Verlangsamung nimmt mit den Tiers zu)
			​​
			([c/2B4EAD:2]) [c/2B4EAD:Fernkampfmodus]: Wechselt in einen Modus, in dem mit einer Waffe geschossen wird. 
			(Diese Waffe skaliert sowohl mit dem Ranger-Schaden als auch mit dem Stand-Schaden).
			'''
		DisplayName: WhiteSnake Tier 4
	}

