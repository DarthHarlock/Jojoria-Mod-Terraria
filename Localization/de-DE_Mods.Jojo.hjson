	CinderellaItem_Tier_3: {
		Tooltip:
			'''
			([c/F389B2:Passiv]): Belegt getroffene Gegner mit dem Debuff ''Entstellt IV'' (-20% Verteidigung / 15% Verlangsamung)
			​​
			[c/F389B2:1]) [c/F389B2:Heilung]: Stellt in einem Bereich Mana und Leben wieder her und wirkt sich auch auf andere Spieler aus
			​​
			[c/F389B2:Garderobe]: Ermöglicht es dir, das Aussehen des Spielers jederzeit zu ändern
			​​
			[c/F389B2:Gesichtsaustausch]: Ändert für kurze Zeit dein Aussehen. Nahe Gegner werden mit Entstellung und Verwirrung belegt
			'''
		DisplayName: Cinderella Tier 3
	}

