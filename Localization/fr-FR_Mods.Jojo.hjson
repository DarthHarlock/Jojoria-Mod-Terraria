	ScaryMonstersItem_Tier_4: {
		DisplayName: Scary Monsters Tier 4
		Tooltip:
			'''
			[c/00A5FF:Passif]) [c/00A5FF:Dino Virus] : Les griffures infligent l’infection Dino Virus. Après [c/00A5FF:7] secondes, l’ennemi se transformera en dinosaure qui vous servira et propagera l’infection
			Les dinosaures transformés ont [c/00A5FF:20] de dégâts de classe Stand et leur vie est calculée en additionnant :
			[c/00A5FF:210] + la vie de l’ennemi transformé.
			​​
			[c/00A5FF:Passif]) [c/00A5FF:Écailles] : Votre corps transformé vous permet d’avoir [c/00A5FF:10%] de dégâts supplémentaires et [c/00A5FF:25%] de vitesse supplémentaire
			​​
			[c/00A5FF:1]) [c/00A5FF:Dino-Crisis] : Invoque [c/00A5FF:4] dinosaures qui vous protégeront, infligeant [c/00A5FF:35] de dégâts de classe Stand
			​​
			[c/00A5FF:2]) [c/00A5FF:Éveil] : Vous vous transformerez complètement et obtiendrez une portée d’attaque plus grande. De plus, si vous utilisez la capacité « Dino-Crisis », vous invoquerez [c/00A5FF:5] dinosaures
			'''
	}

	ScaryMonstersItem_Tier_3: {
		Tooltip:
			'''
			[c/00A5FF:Passif]) [c/00A5FF:Dino Virus] : Les griffures infligent l’infection Dino Virus. Après [c/00A5FF:8] secondes, l’ennemi se transformera en dinosaure qui vous servira et propagera l’infection
			Les dinosaures transformés ont [c/00A5FF:15] de dégâts de classe Stand et leur vie est calculée en additionnant :
			[c/00A5FF:160] + la vie de l’ennemi transformé.
			​​
			[c/00A5FF:Passif]) [c/00A5FF:Écailles] : Votre corps transformé vous permet d’avoir [c/00A5FF:9%] de dégâts supplémentaires et [c/00A5FF:20%] de vitesse supplémentaire
			​​
			[c/00A5FF:1]) [c/00A5FF:Dino-Crisis] : Invoque [c/00A5FF:3] dinosaures qui vous protégeront, infligeant [c/00A5FF:25] de dégâts de classe Stand
			​​
			[c/00A5FF:2]) [c/00A5FF:Éveil] : Vous vous transformerez complètement et obtiendrez une portée d’attaque plus grande. De plus, si vous utilisez la capacité « Dino-Crisis », vous invoquerez [c/00A5FF:4] dinosaures
			'''
		DisplayName: Scary Monsters Tier 3
	}

