	CrazyDiamondItem_Tier_4: {
		DisplayName: Crazy Diamond Tier 4
		Tooltip:
			'''
			[c/77CCF1:1]) [c/77CCF1:Modalità Trasformazione]: Se colpisci un nemico abbastanza a lungo, lo fonderai con una pietra e subirà [c/77CCF1:x6] danni
			​​
			[c/77CCF1:Passiva]) [c/77CCF1:Ripristino]: Ti permette di curare altri giocatori e creature.
			​​
			[c/77CCF1:Passiva]) [c/77CCF1:Smantellamento]: Se colpisci un oggetto a terra, tornerà ai suoi materiali di creazione originali
			​​
			[c/77CCF1:2]) [c/77CCF1:Scudo di Pietra]: Forma uno scudo di [c/77CCF1:20] pietre che protegge l'utente da proiettili e attacchi fisici
			'''
	}

