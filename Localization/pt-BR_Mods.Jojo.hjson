	ScaryMonstersItem_Tier_4: {
		DisplayName: Scary Monsters Tier 4
		Tooltip:
			'''
			[c/00A5FF:Passiva]) [c/00A5FF:Dino Virus]: Os arranhões infligem a infecção Dino Virus. Após [c/00A5FF:7] segundos, o inimigo se transformará em um dinossauro que servirá a você e espalhará a infecção
			Os dinossauros transformados têm [c/00A5FF:20] de dano de classe Stand e sua vida é calculada somando:
			[c/00A5FF:210] + a vida do inimigo transformado.
			​​
			[c/00A5FF:Passiva]) [c/00A5FF:Escamas]: Seu corpo transformado permite que você tenha [c/00A5FF:10%] a mais de dano e [c/00A5FF:25%] a mais de velocidade
			​​
			[c/00A5FF:1]) [c/00A5FF:Dino-Crisis]: Invoca [c/00A5FF:4] dinossauros que irão protegê-lo, causando [c/00A5FF:35] de dano de classe Stand
			​​
			[c/00A5FF:2]) [c/00A5FF:Despertar]: Você se transformará completamente e obterá mais alcance de ataque. Além disso, se usar a habilidade «Dino-Crisis», invocará [c/00A5FF:5] dinossauros
			'''
	}

	ScaryMonstersItem_Tier_3: {
		Tooltip:
			'''
			[c/00A5FF:Passiva]) [c/00A5FF:Dino Virus]: Os arranhões infligem a infecção Dino Virus. Após [c/00A5FF:8] segundos, o inimigo se transformará em um dinossauro que servirá a você e espalhará a infecção
			Os dinossauros transformados têm [c/00A5FF:15] de dano de classe Stand e sua vida é calculada somando:
